# ─── Banco ───────────────────────────────────────────────────────────────────
# Local: Postgres nativo. Produção: connection string do Supabase.
#   - DATABASE_URL  → usada pelo runtime da API (PrismaService).
#     No Supabase, use o "Session pooler" (host ...pooler.supabase.com:5432):
#     é IPv4 e aceita tanto queries quanto migrations.
#   - DIRECT_URL    → opcional; se definida, migrate/seed usam ela em vez da
#     DATABASE_URL (útil se DATABASE_URL apontar pro pooler de transação :6543).
DATABASE_URL="postgresql://fazmais:fazmais_dev@localhost:5432/fazmais_dev?schema=public"
# DIRECT_URL="postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Em produção, gere segredos fortes: `openssl rand -hex 32`
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
# production ativa HSTS + cookie de refresh `secure` + `sameSite=none`
# (necessário porque web e API ficam em domínios diferentes em produção).
NODE_ENV=development
# URL(s) do frontend permitidas no CORS. Aceita várias separadas por vírgula
# (ex: domínio de produção da Vercel + um domínio de preview).
CORS_ORIGIN="http://localhost:5173"
# Diretório de uploads. Local: deixe em branco (usa apps/api/uploads).
# Railway: aponte pro mount point do volume persistente, ex: /data/uploads
# UPLOADS_DIR=/data/uploads

# ─── IA (mock por enquanto) ──────────────────────────────────────────────────
AI_MODE="mock"
ANTHROPIC_API_KEY=
